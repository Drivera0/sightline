# Copy to .env and fill in. Names only: never commit values (LANE_D §4).

# Nebius Token Factory (lane A: sightline/agent/llm.py)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
SIGHTLINE_MODEL_REASON=nvidia/nemotron-3-super-120b-a12b
SIGHTLINE_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
SIGHTLINE_MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
# SIGHTLINE_AGENT_BUDGET_TOKENS=      # per-mission token budget for the agent
# SIGHTLINE_FAKE_LLM=1                # tests and smoke test: no network, canned replies

# Conditions (lane B)
TAVILY_API_KEY=
# SIGHTLINE_FAKE_TAVILY=1             # smoke test: no network

# NVIDIA API catalog (optional)
NVIDIA_API_KEY=

# Detector (lane A): cv2 (OpenCV 5 cv2.dnn, default) or torch
SIGHTLINE_BACKEND=cv2
# SIGHTLINE_ONNX=data/weights/release_v2/...onnx
# SIGHTLINE_WEIGHTS=data/weights/release_v2/...pt

# Photo queue (lane D): local (in-process thread) or sqs (AWS)
SIGHTLINE_QUEUE=local

# Radio desk (lane E): real loads Parakeet + Magpie (NeMo environment, sightline/radio/README.md)
# SIGHTLINE_RADIO_MODELS=real

# Web (Vite): the mission API; unset = demo mode only
VITE_API_URL=

# The mission API: web origins allowed to call it besides localhost (comma-separated), e.g. the Vercel site
# SIGHTLINE_CORS_ORIGINS=https://sightline-iota-sandy.vercel.app
