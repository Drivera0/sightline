# HTTPS for the API with an automatic Let's Encrypt certificate. SITE_ADDRESS is the instance's
# Elastic IP as an sslip.io name (e.g. 35-90-1-2.sslip.io): HTTPS with no DNS to set up.
{$SITE_ADDRESS} {
	reverse_proxy api:8000 {
		flush_interval -1   # SSE (/missions/{id}/events) must not be buffered
	}
}
